@@ -82,6 +82,45 @@ func firstAccountTestOptions(opts []AccountTestOptions) AccountTestOptions {
 // maxAccountTestMediaBytes caps inbound data-URL payloads for admin tests (~8 MiB).
 const maxAccountTestMediaBytes = 8 << 20
 
+// accountTestTextPromptContextKey carries the admin-supplied test message.
+const accountTestTextPromptContextKey = "account_test_text_prompt"
+
+// defaultAccountTestTextPrompt is what text probes send when no message is given.
+const defaultAccountTestTextPrompt = "hi"
+
+// maxAccountTestTextPromptRunes caps the test message: a probe checks that the account answers,
+// it is not a place for long documents (which would also cost real tokens on every test).
+const maxAccountTestTextPromptRunes = 4000
+
+// clampTestTextPrompt trims the message and cuts it to maxAccountTestTextPromptRunes.
+func clampTestTextPrompt(prompt string) string {
+	text := strings.TrimSpace(prompt)
+	if runes := []rune(text); len(runes) > maxAccountTestTextPromptRunes {
+		text = strings.TrimSpace(string(runes[:maxAccountTestTextPromptRunes]))
+	}
+	return text
+}
+
+// accountTestTextPrompt returns the message a text probe should send.
+func accountTestTextPrompt(c *gin.Context) string {
+	if c != nil {
+		if prompt := clampTestTextPrompt(c.GetString(accountTestTextPromptContextKey)); prompt != "" {
+			return prompt
+		}
+	}
+	return defaultAccountTestTextPrompt
+}
+
+// pickTestTextPrompt returns the first non-empty prompt, or the default.
+func pickTestTextPrompt(prompt []string) string {
+	for _, p := range prompt {
+		if text := clampTestTextPrompt(p); text != "" {
+			return text
+		}
+	}
+	return defaultAccountTestTextPrompt
+}
+
